{
  "opencollection": "1.0.0",
  "info": {
    "name": "Jupyter Server REST Checkpoints Kernelspecs API",
    "version": "2.14.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Kernelspecs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Jupyter Server List kernel specifications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8888/api/kernelspecs"
          },
          "docs": "Returns the available kernel specifications."
        }
      ]
    }
  ],
  "bundled": true
}