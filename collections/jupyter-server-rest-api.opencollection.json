          "http": {
            "method": "POST",
            "url": "http://localhost:8888/api/contents/:path/checkpoints/:checkpoint_id",
            "params": [
              {
                "name": "path",
                "value": "",
                "type": "path"
              },
              {
                "name": "checkpoint_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Restores the file from the named checkpoint."
        },
        {
          "info": {
            "name": "Jupyter Server Delete checkpoint",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://localhost:8888/api/contents/:path/checkpoints/:checkpoint_id",
            "params": [
              {
                "name": "path",
                "value": "",
                "type": "path"
              },
              {
                "name": "checkpoint_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes the checkpoint with the given ID."
        }
      ]
    },
